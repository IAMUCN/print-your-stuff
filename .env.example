# ==========================================
# Hostel Print Automation - Environment Configuration
# ==========================================

# Server Listening Port & Host
PORT=3000
HOST=0.0.0.0

# PostgreSQL Database Connection String (e.g., Supabase / Neon / Local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/hostel_print

# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Public Webhook URL (Required when deploying to Render / Railway / Cloud)
# e.g., https://hostel-print-backend.onrender.com
# Leave empty when running locally for automatic long-polling mode.
WEBHOOK_URL=

# JWT Secret Key for Desktop Admin App authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Initial Admin Credentials (seeded into database on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_123
